# Data/ holds PCAPs, Zeek logs and derived files. Only the split
# definition is committed.
/Data/*
!/Data/processed/
/Data/processed/*
!/Data/processed/GraphTunnel/
/Data/processed/GraphTunnel/*
!/Data/processed/GraphTunnel/splits.csv
datas

# --- notebooks/ (DNS tunnelling ML model) ---
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
notebooks/DNS-Tunnel-Datasets/
notebooks/dataset/
notebooks/dataset_zeek/

# Trained models (regenerate with the notebook, see notebooks/README.md) and
# executed notebook copies. results/zeek_run.md is committed. The final model
# is committed too, for live scoring; each level is re-included in turn,
# because git can't re-include a file inside an ignored folder.
/models/*
!/models/zeek_bilstm/
/models/zeek_bilstm/*
!/models/zeek_bilstm/run4_default_50ep/
/models/zeek_bilstm/run4_default_50ep/*
!/models/zeek_bilstm/run4_default_50ep/final/
/results/executed/

# Tests, kept locally only.
/tests/
/pytest.ini
/.pytest_cache/
/results/web_scoring_log.csv